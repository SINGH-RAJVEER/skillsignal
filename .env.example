# Postgres (used by docker-compose)
# POSTGRES_PASSWORD is required by docker-compose; the rest have defaults.
POSTGRES_DB=skillsignal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Database
# Domain services and workers accept DATABASE_URL directly. The migrator can
# also assemble it from the individual DATABASE_* variables below.
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillsignal

# Required by the migrator when DATABASE_URL is not set
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=skillsignal
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# Auth (identity service)
# JWT_SECRET is required, at least 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional. Duration format: <number><ms|s|m|h>. Default: 168h
JWT_TTL=168h

# Storage (documents service, parser worker, and inference worker)
# Optional. Default: .local-storage
STORAGE_ROOT=.local-storage

# Retention (identity coordinates sweeps through the owning services)
# Optional. Defaults shown. Independent evaluations expire after
# INDEPENDENT_RETENTION_DAYS; the sweep loop runs every
# RETENTION_SWEEP_INTERVAL_SECONDS (0 disables it).
INDEPENDENT_RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_SECONDS=3600

# URLs
# Optional. Default: http://localhost:3000
WEB_URL=http://localhost:3000
# Gateway upstream defaults target Docker Compose service names. Set these to
# localhost ports only when running the processes without devenv or Compose.
IDENTITY_URL=http://identity:8080
HIRING_URL=http://hiring:8080
DOCUMENTS_URL=http://documents:8080
EVALUATION_URL=http://evaluation:8080
BILLING_URL=http://billing:8080

# Worker tuning
# Optional. Defaults shown.
# WORKER_ROLE is required and accepts parser or inference. Compose sets it per
# worker process, so it normally stays unset in the shared .env file.
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=60
# 0 keeps workers running. A positive value stops a worker once no job anywhere
# in the pipeline has been ready or processing for that many seconds.
WORKER_IDLE_EXIT_SECONDS=0
PARSE_TIMEOUT_SECONDS=30

# OpenRouter (inference worker only)
# Inference requires OPENROUTER_API_KEY. Model lists must contain free models
# with the required capabilities; startup and periodic catalog checks enforce it.
# The parser worker rejects this credential if it is present.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EXTRACTION_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_ASSESSMENT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_EXTRACTION_FALLBACKS=liquid/lfm-2.5-2.6b:free
OPENROUTER_ASSESSMENT_FALLBACKS=liquid/lfm-2.5-2.6b:free
OPENROUTER_EMBEDDING_FALLBACKS=liquid/lfm-2.5-embedding-350m:free
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_OUTPUT_TOKENS=4096

# OpenTelemetry (gateway, domain services, and workers)
# Tracing and metrics stay off until OTEL_EXPORTER_OTLP_ENDPOINT is set.
# The exporters append /v1/traces and /v1/metrics to the base endpoint.
# Standard OTEL variables are honored, e.g.:
#   OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token>
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Web (build time, passed via VITE_* in docker-compose)
# Optional. Defaults shown.
VITE_API_URL=http://localhost:8000
VITE_ENTERPRISE_SALES_EMAIL=sales@skillsignal.app

# Points and Razorpay (billing service and inference worker)
# Optional. Defaults shown.
POINTS_PER_USD=1000
MIN_POINTS_INDEPENDENT_EVALUATION=10
MIN_POINTS_EMPLOYER_RESUME=5
PRICE_CEILING_INPUT_USD_PER_MILLION=3.0
PRICE_CEILING_OUTPUT_USD_PER_MILLION=15.0

# Razorpay (billing service). Without key credentials, order creation answers 503
# and webhooks stay disabled. Packs are a JSON array of
# {id, points, amountInr}.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PACKS=[{"id":"pack-500","points":500,"amountInr":499},{"id":"pack-2000","points":2000,"amountInr":1499}]

# Operator token for manual enterprise entitlement provisioning and
# retention sweeps. Leave empty to disable the admin endpoints entirely.
ADMIN_TOKEN=
ENTERPRISE_SALES_EMAIL=sales@skillsignal.app
